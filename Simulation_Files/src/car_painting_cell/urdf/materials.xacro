<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Industrial Robotics Color Palette -->
  <material name="industrial_orange">
    <color rgba="0.88 0.38 0.05 1.0"/>
  </material>

  <material name="chassis_dark_gray">
    <color rgba="0.18 0.20 0.24 1.0"/>
  </material>

  <material name="arm_light_gray">
    <color rgba="0.82 0.84 0.87 1.0"/>
  </material>

  <material name="joint_dark">
    <color rgba="0.25 0.27 0.30 1.0"/>
  </material>

  <material name="rubber_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="metallic_silver">
    <color rgba="0.75 0.77 0.80 1.0"/>
  </material>

  <material name="nozzle_gold">
    <color rgba="0.95 0.70 0.10 1.0"/>
  </material>

  <material name="spray_cone_cyan">
    <color rgba="0.10 0.80 1.00 0.40"/>
  </material>

</robot>
