      <!-- ==================== FLOOR MARKING E: OPERATOR / CONTROL STATION ==================== -->
      <visual name="operator_station_marking">
        <pose>-5.0 -4.35 0.0025 0 0 0</pose>
        <geometry>
          <box>
            <size>1.40 0.90 0.002</size>
          </box>
        </geometry>
        <material>
          <!-- Safety Green indicator -->
          <ambient>0.10 0.60 0.25 1.0</ambient>
          <diffuse>0.15 0.72 0.30 1.0</diffuse>
          <emissive>0.05 0.15 0.05 1.0</emissive>
