      <visual name="mark_wheel_rr">
        <pose>-1.40 -0.86 0.0025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 0.32 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.35 0.40 1.0</ambient>
          <diffuse>0.40 0.45 0.50 1.0</diffuse>
        </material>
      </visual>

      <!-- ==================== FLOOR MARKING B: ROBOT NAVIGATION CORRIDOR ==================== -->
      <!-- High-visibility cyan navigation loop defining the designated robot travel centerline -->
      <!-- Standoff distance ~1.2m to 1.5m from car perimeter -->

      <!-- Front robot track line -->
      <visual name="robot_track_front">
        <pose>3.85 0 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 4.90 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.65 0.85 1.0</ambient>
          <diffuse>0.0 0.78 0.98 1.0</diffuse>
          <emissive>0.0 0.18 0.25 1.0</emissive>
        </material>
      </visual>

      <!-- Rear robot track line -->
      <visual name="robot_track_rear">
        <pose>-3.85 0 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 4.90 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.65 0.85 1.0</ambient>
          <diffuse>0.0 0.78 0.98 1.0</diffuse>
          <emissive>0.0 0.18 0.25 1.0</emissive>
        </material>
      </visual>

      <!-- Left flank robot track line -->
      <visual name="robot_track_left">
        <pose>0 2.45 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>7.80 0.10 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.65 0.85 1.0</ambient>
          <diffuse>0.0 0.78 0.98 1.0</diffuse>
          <emissive>0.0 0.18 0.25 1.0</emissive>
        </material>
      </visual>

      <!-- Right flank robot track line -->
      <visual name="robot_track_right">
        <pose>0 -2.45 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>7.80 0.10 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.65 0.85 1.0</ambient>
          <diffuse>0.0 0.78 0.98 1.0</diffuse>
          <emissive>0.0 0.18 0.25 1.0</emissive>
        </material>
      </visual>

      <!-- ==================== FLOOR MARKING C: 4 EXTERIOR PAINTING STATIONS ==================== -->
      <!-- Visual colored stations indicating where the robot executes painting trajectories -->

      <!-- Station 1: Front Surface Zone (Hood & Front Bumper) -->
      <visual name="station_front_zone">
        <pose>3.85 0 0.0015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.90 2.40 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.45 0.75 0.4</ambient>
          <diffuse>0.25 0.55 0.85 0.4</diffuse>
        </material>
      </visual>

      <!-- Station 2: Left Flank Zone (Doors, Pillars, Left Roof) -->
      <visual name="station_left_zone">
        <pose>0 2.45 0.0015 0 0 0</pose>
        <geometry>
          <box>
            <size>4.80 0.80 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.45 0.75 0.4</ambient>
          <diffuse>0.25 0.55 0.85 0.4</diffuse>
