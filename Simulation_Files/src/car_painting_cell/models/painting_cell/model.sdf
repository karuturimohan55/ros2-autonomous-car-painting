            <size>4.80 0.80 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.45 0.75 0.4</ambient>
          <diffuse>0.25 0.55 0.85 0.4</diffuse>
        </material>
      </visual>

      <!-- ==================== FLOOR MARKING D: OUTER HAZARD PERIMETER ==================== -->
      <!-- High-contrast perimeter border (11.6m x 8.0m) marking cell clearance buffer -->
      <visual name="hazard_border_north">
        <pose>5.80 0 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 8.0 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.55 0.02 1.0</ambient>
          <diffuse>0.98 0.60 0.05 1.0</diffuse>
          <emissive>0.10 0.05 0.0 1.0</emissive>
        </material>
