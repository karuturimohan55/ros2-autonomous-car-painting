        <geometry>
          <box>
            <size>0.20 10.20 4.20</size>
          </box>
        </geometry>
      </collision>

      <!-- East Wall (+Y) -->
      <visual name="east_wall_visual">
        <pose>0 5.0 2.10 0 0 0</pose>
        <geometry>
          <box>
            <size>14.20 0.20 4.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.87 0.90 1.0</ambient>
          <diffuse>0.88 0.90 0.92 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>

      <visual name="east_baseboard_visual">
        <pose>0 4.89 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>14.18 0.04 0.40</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.28 0.32 1.0</ambient>
          <diffuse>0.30 0.33 0.38 1.0</diffuse>
