<?xml version="1.0"?>
<sdf version="1.6">
  <model name="painting_cell">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="cell_structure_link">
      <!-- ==================== INDUSTRIAL EPOXY FLOOR ==================== -->
      <!-- Dimensions: 15.0m x 11.0m x 0.10m, centered at z = -0.05m -> Top surface is at z = 0.00m -->
      <visual name="floor_visual">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>15.0 11.0 0.10</size>
          </box>
        </geometry>
        <material>
          <!-- Clean industrial light slate epoxy finish -->
          <ambient>0.78 0.80 0.83 1.0</ambient>
          <diffuse>0.82 0.85 0.88 1.0</diffuse>
          <specular>0.35 0.35 0.35 1.0</specular>
        </material>
      </visual>

      <collision name="floor_collision">
        <pose>0 0 -0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>15.0 11.0 0.10</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- ==================== SURROUNDING ENCLOSURE WALLS ==================== -->
      <!-- Dimensions: Length=14.0m, Width=10.0m, Height=4.20m (z: 0.00m to 4.20m) -->

      <!-- North Wall (+X) -->
      <visual name="north_wall_visual">
        <pose>7.0 0 2.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 10.20 4.20</size>
          </box>
        </geometry>
        <material>
          <!-- Cleanroom white / light industrial panel -->
          <ambient>0.85 0.87 0.90 1.0</ambient>
          <diffuse>0.88 0.90 0.92 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>

      <visual name="north_baseboard_visual">
        <pose>6.89 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 10.18 0.40</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.28 0.32 1.0</ambient>
          <diffuse>0.30 0.33 0.38 1.0</diffuse>
        </material>
      </visual>

      <collision name="north_wall_collision">
        <pose>7.0 0 2.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 10.20 4.20</size>
          </box>
        </geometry>
      </collision>

      <!-- South Wall (-X) -->
      <visual name="south_wall_visual">
        <pose>-7.0 0 2.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 10.20 4.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.87 0.90 1.0</ambient>
          <diffuse>0.88 0.90 0.92 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
        </material>
      </visual>

      <visual name="south_baseboard_visual">
        <pose>-6.89 0 0.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 10.18 0.40</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.28 0.32 1.0</ambient>
          <diffuse>0.30 0.33 0.38 1.0</diffuse>
        </material>
