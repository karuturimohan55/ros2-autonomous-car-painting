            <size>0.80 0.32 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.35 0.40 1.0</ambient>
          <diffuse>0.40 0.45 0.50 1.0</diffuse>
        </material>
      </visual>

      <visual name="mark_wheel_rl">
        <pose>-1.40 0.86 0.0025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 0.32 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.35 0.40 1.0</ambient>
          <diffuse>0.40 0.45 0.50 1.0</diffuse>
