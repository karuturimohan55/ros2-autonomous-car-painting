        <pose>0 -5.0 2.10 0 0 0</pose>
        <geometry>
          <box>
            <size>14.20 0.20 4.20</size>
          </box>
        </geometry>
      </collision>

      <!-- ==================== VENTILATION & EXHAUST FILTER BANKS ==================== -->
      <!-- Typical downdraft/crossdraft paint booth ventilation grills at lower wall -->
      <visual name="vent_north_visual">
        <pose>6.88 0 1.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 6.0 1.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.22 0.25 1.0</ambient>
          <diffuse>0.30 0.32 0.35 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <visual name="vent_south_visual">
        <pose>-6.88 0 1.20 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 6.0 1.20</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.22 0.25 1.0</ambient>
          <diffuse>0.30 0.32 0.35 1.0</diffuse>
          <specular>0.4 0.4 0.4 1.0</specular>
        </material>
      </visual>

      <!-- ==================== FLOOR MARKING A: VEHICLE STAGING BAY ==================== -->
      <!-- Yellow perimeter box around stationary car footprint (5.4m x 2.4m) -->
      <!-- Front marking line -->
      <visual name="mark_car_front">
        <pose>2.65 0 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 2.40 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.90 0.75 0.02 1.0</ambient>
          <diffuse>0.96 0.82 0.05 1.0</diffuse>
          <emissive>0.15 0.12 0.0 1.0</emissive>
        </material>
      </visual>

      <!-- Rear marking line -->
      <visual name="mark_car_rear">
        <pose>-2.65 0 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 2.40 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.90 0.75 0.02 1.0</ambient>
          <diffuse>0.96 0.82 0.05 1.0</diffuse>
          <emissive>0.15 0.12 0.0 1.0</emissive>
        </material>
      </visual>

      <!-- Left marking line -->
      <visual name="mark_car_left">
        <pose>0 1.20 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>5.40 0.10 0.002</size>
