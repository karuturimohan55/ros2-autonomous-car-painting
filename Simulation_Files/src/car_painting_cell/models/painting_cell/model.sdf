        <pose>0 -1.20 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>5.40 0.10 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.90 0.75 0.02 1.0</ambient>
          <diffuse>0.96 0.82 0.05 1.0</diffuse>
          <emissive>0.15 0.12 0.0 1.0</emissive>
        </material>
      </visual>

      <!-- Wheel Position Targets (FL, FR, RL, RR) -->
      <visual name="mark_wheel_fl">
        <pose>1.40 0.86 0.0025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80 0.32 0.002</size>
