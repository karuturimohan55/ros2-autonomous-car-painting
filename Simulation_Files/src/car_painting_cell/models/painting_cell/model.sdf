        <pose>-5.80 0 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>0.12 8.0 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.55 0.02 1.0</ambient>
          <diffuse>0.98 0.60 0.05 1.0</diffuse>
          <emissive>0.10 0.05 0.0 1.0</emissive>
        </material>
      </visual>

      <visual name="hazard_border_east">
        <pose>0 4.0 0.002 0 0 0</pose>
        <geometry>
          <box>
            <size>11.72 0.12 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.55 0.02 1.0</ambient>
          <diffuse>0.98 0.60 0.05 1.0</diffuse>
          <emissive>0.10 0.05 0.0 1.0</emissive>
        </material>
